# Overview of all settings. Copy the relevant parts to:
#   backend/.env         (backend settings; full template in backend/.env.example)
#   frontend/.env.local  (frontend settings; template in frontend/.env.local.example)
# Placeholders only - never commit real values.

# ---- Backend ----
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///./ads_copilot.db
CORS_ORIGINS=http://localhost:3000

# Reserved for upcoming Gemini features (optional, not used yet)
GEMINI_API_KEY=

# Google Ads API (required for live campaign data)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Port used by backend/get_refresh_token.py for the OAuth redirect
OAUTH_REDIRECT_PORT=8080

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
