# Environment: development | production
ENVIRONMENT=development
DEBUG=false

# Database
# Development: SQLite (default)
# Production: PostgreSQL, e.g. postgresql://user:pass@host:5432/ads_copilot
DATABASE_URL=sqlite:///./ads_copilot.db

# CORS - comma-separated origins
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# AI (required)
GEMINI_API_KEY=your_gemini_api_key

# Google Ads API (required for production - real campaign data)
# Get from: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
# Optional: MCC (manager) account ID for multi-account access
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890
