# Copy to backend/.env and fill in your own values. Never commit backend/.env.

# Environment: development | production (production disables /docs and /redoc)
ENVIRONMENT=development
DEBUG=false

# Database
# Development: SQLite (default)
# Production: PostgreSQL, e.g. postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=sqlite:///./ads_copilot.db

# CORS - comma-separated list of exact frontend origins ('*' is rejected)
CORS_ORIGINS=http://localhost:3000

# AI - reserved for upcoming Gemini features (optional, not used yet)
GEMINI_API_KEY=

# Google Ads API (required for live campaign data)
# Developer token: https://ads.google.com/aw/apicenter
# OAuth client:    Google Cloud Console > APIs & Services > Credentials
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Generate with: python get_refresh_token.py
GOOGLE_ADS_REFRESH_TOKEN=
# Optional: manager (MCC) account ID, format 123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Local port for the OAuth redirect used by get_refresh_token.py
OAUTH_REDIRECT_PORT=8080
